{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/human_decision.schema.json",
  "title": "HumanDecision",
  "description": "Explicit operator decision; timeout is represented by an expired proposal, not a HumanDecision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "decided_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "decision": {"type": "string", "enum": ["approve", "reject"]},
    "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "operator_id": {"type": ["string", "null"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/raw_radio_input.schema.json",
  "title": "RawRadioInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_id", "timestamp", "transcript"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "input_id": {"type": "string", "minLength": 1},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "audio_reference": {"type": ["string", "null"]},
    "transcript": {"type": "string", "minLength": 1},
    "channel": {"type": ["string", "null"]},
    "speaker_id": {"type": ["string", "null"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}

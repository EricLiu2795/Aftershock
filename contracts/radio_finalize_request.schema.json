{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/radio_finalize_request.schema.json",
  "title": "RadioFinalizeRequest",
  "description": "A complete, client-finalized radio transcript. Session and responder authority are derived from server state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transmission_id",
    "transcript",
    "capture_started_at",
    "capture_ended_at",
    "segments"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "transmission_id": {"type": "string", "minLength": 1},
    "transcript": {"type": "string", "minLength": 1, "maxLength": 10000, "pattern": "\\S"},
    "provider_session_reference": {"type": "string", "minLength": 1},
    "capture_started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "capture_ended_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/segment"}
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "text", "started_at_ms", "ended_at_ms"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "started_at_ms": {"type": "integer", "minimum": 0},
        "ended_at_ms": {"type": "integer", "minimum": 0},
        "provider_segment_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

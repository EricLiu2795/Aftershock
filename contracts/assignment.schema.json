{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/assignment.schema.json",
  "title": "Assignment",
  "description": "Execution assignment connecting a ResourceUnit to one Worksite objective.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assignment_id", "resource_id", "worksite_id", "task_type", "status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "assignment_id": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "worksite_id": {"type": "string", "minLength": 1},
    "task_type": {"$ref": "common.schema.json#/$defs/taskType"},
    "status": {"type": "string", "enum": ["proposed", "active", "completed", "cancelled"]},
    "route_id": {"type": ["string", "null"]},
    "source_decision_id": {"type": ["string", "null"]},
    "assigned_at": {"type": ["string", "null"], "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}

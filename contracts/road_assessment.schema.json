{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/road_assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "road_state": {
      "$ref": "road_state.schema.json"
    },
    "passability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foot": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "blocked",
            "limited",
            "open",
            null
          ]
        },
        "vehicle": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "blocked",
            "limited",
            "open",
            null
          ]
        }
      },
      "required": [
        "foot",
        "vehicle"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence_item.schema.json"
      }
    },
    "verification_status": {
      "$ref": "common.schema.json#/$defs/verificationStatus"
    }
  },
  "required": [
    "schema_version",
    "assessment_id",
    "road_state",
    "passability",
    "evidence",
    "verification_status"
  ]
}

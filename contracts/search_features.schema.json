{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/search_features.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "potential_impact": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "criticality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_conflict": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "potential_impact",
    "uncertainty",
    "criticality",
    "evidence_conflict"
  ]
}

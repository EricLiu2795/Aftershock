{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/search_task.schema.json",
  "title": "SearchTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "worksite_id", "task_type", "created_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "task_id": {"type": "string", "minLength": 1},
    "worksite_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "enum": ["verify_worksite", "assess_damage", "check_access", "scan_route"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}

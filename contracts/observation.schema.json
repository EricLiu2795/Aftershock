{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/observation.schema.json",
  "title": "StructuredObservation",
  "description": "Normalized facts extracted from raw input; it contains no operational decision or AI-invented worksite identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "timestamp", "source_type", "location", "incident_type", "victim_indication", "structural_hazard", "access_status", "verification_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "observation_id": {"type": "string", "minLength": 1},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "source_type": {"$ref": "common.schema.json#/$defs/sourceType"},
    "source_id": {"type": ["string", "null"]},
    "location": {"$ref": "common.schema.json#/$defs/location"},
    "incident_type": {"$ref": "common.schema.json#/$defs/incidentType"},
    "victim_indication": {"$ref": "common.schema.json#/$defs/victimIndication"},
    "structural_hazard": {"type": "string", "enum": ["none", "reported_damage", "minor_damage", "major_damage", "severe_collapse", "active_secondary_hazard", "unknown"]},
    "access_status": {"type": "string", "enum": ["open", "possibly_blocked", "blocked", "limited", "unknown"]},
    "verification_status": {"$ref": "common.schema.json#/$defs/verificationStatus"},
    "evidence_strength": {"$ref": "common.schema.json#/$defs/evidenceStrength"},
    "raw_source_reference": {"$ref": "common.schema.json#/$defs/rawSourceReference"},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}

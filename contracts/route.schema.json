{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftershock.local/contracts/route.schema.json",
  "title": "Route",
  "description": "Execution route generated for a resource and one Worksite objective.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "resource_id", "worksite_id", "path", "estimated_travel_time", "generated_from_state_version", "created_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "route_id": {"type": "string", "minLength": 1},
    "resource_id": {"type": "string", "minLength": 1},
    "worksite_id": {"type": "string", "minLength": 1},
    "path": {"type": "array", "minItems": 2, "items": {"$ref": "common.schema.json#/$defs/coordinate"}},
    "estimated_travel_time": {"type": "number", "minimum": 0},
    "generated_from_state_version": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}

# API
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/aftershock.sqlite
SESSION_SIGNING_SECRET=
PRESENTER_API_KEY=
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
JOIN_CODE_TTL_MINUTES=15
MAX_TRANSCRIPT_CHARACTERS=10000
MAX_REQUEST_BYTES=65536
TOKEN_REQUESTS_PER_MINUTE=6
SESSION_TOKEN_REQUESTS_PER_MINUTE=30

# ElevenLabs (server-only; never prefix this with VITE_)
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# Extraction. Leave LLM_API_KEY empty to use deterministic extraction.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_MS=20000
EXTRACTION_POLL_MS=250
EXTRACTION_LEASE_MS=30000
EXTRACTION_MAX_ATTEMPTS=2
REPLAY_ENABLED=true

# Social ingestion
# Copy to `.env` in this directory and paste local values. Do not commit `.env`.
# The demo CLI loads `.env` without overriding variables already set in the shell.
# Offline replay/fixture mode does not require OpenAI credentials.

INGESTION_MODE=replay
INGESTION_AI_PROVIDER=fixture

# Required only for live OpenAI extraction (`--provider openai`).
# Use a model that supports the Responses API Structured Outputs (`text.format` + `strict`).
OPENAI_API_KEY=
INGESTION_AI_MODEL=

INGESTION_AI_BASE_URL=https://api.openai.com/v1
INGESTION_HTTP_TIMEOUT=15
INGESTION_AI_TIMEOUT=45
# INGESTION_DEBUG=1

INGESTION_COUNTRY=Venezuela
INGESTION_SINCE=
INGESTION_UNTIL=
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
GDACS_EVENT_TYPES=EQ
GDACS_EVENT_ID=
RELIEFWEB_API_URL=https://api.reliefweb.int/v2/reports
# Obtain a pre-approved appname from ReliefWeb before using its live API.
RELIEFWEB_APPNAME=
RELIEFWEB_QUERY=earthquake
INGESTION_REPLAY_FILE=data/social_replay_caraballeda.json
INGESTION_FIXTURE_FILE=data/ingestion_ai_responses.json

# Browser-safe public token; restrict it to your app URLs in Mapbox.
VITE_MAPBOX_ACCESS_TOKEN=
# Optional Python runtime override; local .venv/bin/python is detected automatically.
PYTHON_BIN=
